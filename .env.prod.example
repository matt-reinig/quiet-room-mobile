EXPO_PUBLIC_APP_VARIANT=prod
EXPO_PUBLIC_RELEASE_ENV=prod

EXPO_PUBLIC_API_BASE=https://your-prod-api.com
EXPO_PUBLIC_STREAMING_BASE=
EXPO_PUBLIC_RENDER_MODE=native
EXPO_PUBLIC_WEB_APP_URL=https://your-prod-web-app.com

EXPO_PUBLIC_FB_API_KEY=
EXPO_PUBLIC_FB_AUTH_DOMAIN=
EXPO_PUBLIC_FB_PROJECT_ID=
EXPO_PUBLIC_CONTACT_EMAIL=your-email@example.com
EXPO_PUBLIC_DEFAULT_MODEL=gpt-5.1-chat-latest
EXPO_PUBLIC_MODEL_OPTIONS=gpt-5.1-chat-latest,gpt-5.3-chat-latest
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional explicit service file overrides for the prod app identity.
# EXPO_PUBLIC_GOOGLE_SERVICES_FILE=./google-services.prod.json
# EXPO_PUBLIC_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.prod.plist
