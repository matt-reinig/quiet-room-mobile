# App identity and backend target.
# App variant chooses bundle/package ids, app name, scheme, and default service files.
# Release env chooses which backend the build should talk to.
EXPO_PUBLIC_APP_VARIANT=qa
EXPO_PUBLIC_RELEASE_ENV=qa

# Use the same QA backend as quiet-room-qa.vercel.app
EXPO_PUBLIC_API_BASE=https://6rc3hj3tvyjheia4ilr5svat5i0vdkzm.lambda-url.us-east-1.on.aws/
EXPO_PUBLIC_STREAMING_BASE=https://wcqbsjvwjbv3hvkthaoxqboljq0kmcap.lambda-url.us-east-1.on.aws/

# Optional local backend override (Android emulator)
# EXPO_PUBLIC_API_BASE=http://10.0.2.2:5000
# EXPO_PUBLIC_STREAMING_BASE=

# Render mode: native (React Native UI) or webview (exact web parity)
EXPO_PUBLIC_RENDER_MODE=native
EXPO_PUBLIC_WEB_APP_URL=https://quiet-room-qa.vercel.app

EXPO_PUBLIC_FB_API_KEY=
EXPO_PUBLIC_FB_AUTH_DOMAIN=
EXPO_PUBLIC_FB_PROJECT_ID=
EXPO_PUBLIC_CONTACT_EMAIL=Quietroomapp@gmail.com
EXPO_PUBLIC_DEFAULT_MODEL=gpt-5.1-chat-latest
EXPO_PUBLIC_MODEL_OPTIONS=gpt-5.1-chat-latest,gpt-5.3-chat-latest
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional explicit native service file overrides.
# If omitted, app.config.js prefers variant-specific files and falls back to the legacy names.
# EXPO_PUBLIC_GOOGLE_SERVICES_FILE=./google-services.qa.json
# EXPO_PUBLIC_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.qa.plist
