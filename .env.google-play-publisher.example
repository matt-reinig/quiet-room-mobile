# Keep the real file outside the repository, for example:
#   /Users/mjreinig/projects/Gabriel_App/.local/google-play-publisher.env
#
# It should point at a local-only Google Cloud service-account JSON that has
# the required Play Console permissions for the QA and production app records.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/to/google-play-service-account.json
