{
  "expo": {
    "name": "Quiet Room",
    "slug": "quiet-room-mobile",
    "version": "1.0.0",
    "scheme": "quietroommobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/branding/quiet-room-door-wordmark-marketing-splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "10",
      "bundleIdentifier": "com.quietroom.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quietroom.mobile",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/quiet-room-door-wordmark-marketing.png",
          "resizeMode": "contain",
          "imageWidth": 320,
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/branding/quiet-room-door-wordmark-marketing.png",
            "resizeMode": "contain",
            "imageWidth": 160
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ]
  }
}
