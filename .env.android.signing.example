# Android upload-key settings for Play release builds.
# scripts/with-mobile-env.sh will auto-load this file when present as `.env.android.signing`.
# `QUIET_ROOM_ANDROID_UPLOAD_STORE_FILE` may be absolute or relative to the repo root.

QUIET_ROOM_ANDROID_UPLOAD_STORE_FILE=android-upload-key.jks
QUIET_ROOM_ANDROID_UPLOAD_STORE_PASSWORD=
QUIET_ROOM_ANDROID_UPLOAD_KEY_ALIAS=upload
QUIET_ROOM_ANDROID_UPLOAD_KEY_PASSWORD=
